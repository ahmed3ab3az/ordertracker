# Copy this file to .env for local development.
# In production, credentials are stored encrypted in the OS keyring via the Settings dialog.

# Neon PostgreSQL connection string
# Format: postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-xxx.neon.tech/ordertracker?sslmode=require

# App settings
ORDERTRACKER_ENV=development
ORDERTRACKER_LOG_LEVEL=INFO
ORDERTRACKER_DEFAULT_LANG=en

# Auto-updater
ORDERTRACKER_RELEASES_REPO=ahmed3ab3az/ordertracker
ORDERTRACKER_CURRENT_VERSION=0.1.0
